<UserControl x:Class="SmartX.Views.SensorIngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Form Panel -->
        <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" Margin="0,0,20,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Content="&lt; Back to Gateway Menu" Background="Transparent" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" HorizontalAlignment="Left" Click="BtnBack_Click" Margin="0,0,0,16"/>

                    <TextBlock Text="Device Sensor Registration" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="MAC Address Syntax (XX:XX:XX:XX:XX:XX)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtMac" Margin="0,4,0,12"/>

                    <TextBlock Text="Deployment Zone / Node" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtLocation" Margin="0,4,0,12"/>

                    <TextBlock Text="Category Selection" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbCategory" Margin="0,4,0,16">
                        <ComboBoxItem Content="Environmental (Moisture/Temp)" IsSelected="True"/>
                        <ComboBoxItem Content="Power Consumption (Watts)"/>
                        <ComboBoxItem Content="Actuator (Valve/Switch)"/>
                    </ComboBox>

                    <!-- Buttons Layout Fix -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Register Sensor" Style="{StaticResource ModernButton}" Click="BtnRegister_Click"/>
                        <Button Grid.Column="2" Content="Random Seed" Background="#64748B" Style="{StaticResource ModernButton}" Click="BtnRandomSeed_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrushColor}" Margin="0,4,0,16"/>

                    <!-- Media Attachment Section -->
                    <TextBlock Text="Encrypted Media / Log Upload" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Select Device Log / Config File" Style="{StaticResource ModernButton}" Background="{StaticResource AccentCyan}" Click="BtnSelectFile_Click" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtFilePath" Text="No file attached" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" FontSize="11"/>
                    <Button Content="Upload &amp; Encrypt Stream" Style="{StaticResource ModernButton}" Background="{StaticResource AccentGreen}" Click="BtnUploadFile_Click" Margin="0,0,0,16"/>

                    <Separator Background="{StaticResource BorderBrushColor}" Margin="0,4,0,16"/>

                    <!-- Recursive Tree Validation Section -->
                    <TextBlock Text="Recursive Deployment Hierarchy" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Execute Recursive Tree Audit" Style="{StaticResource ModernButton}" Background="#8B5CF6" Click="BtnValidateTree_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Sensor DataGrid Panel -->
        <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Registered Sensor Registry" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="Open Operator Telemetry Engine >" Style="{StaticResource ModernButton}" Background="{StaticResource AccentBlue}" DockPanel.Dock="Right" Click="BtnOpenTelemetry_Click"/>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="DgSensors" AutoGenerateColumns="False" 
                          Background="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" 
                          Foreground="{StaticResource TextPrimary}" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                          BorderThickness="1" BorderBrush="{StaticResource BorderBrushColor}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="160"/>
                        <DataGridTextColumn Header="Deployment Location" Binding="{Binding Location}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn Header="Registration Timestamp" Binding="{Binding RegisteredAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>