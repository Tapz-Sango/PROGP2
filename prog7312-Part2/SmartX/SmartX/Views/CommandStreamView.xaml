<UserControl x:Class="SmartX.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SmartX.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header pills -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Real-Time Command Stream &amp; History"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border Background="#FEF2F2" CornerRadius="14" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtCriticalCount" Text="CRITICAL: 0" Foreground="#B91C1C" FontWeight="Bold" FontSize="11"/>
                </Border>
                <Border Background="#F0F9FF" CornerRadius="14" Padding="10,4">
                    <TextBlock x:Name="TxtFifoCount" Text="FIFO: 0" Foreground="#0369A1" FontWeight="Bold" FontSize="11"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Chart + Devices -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Live telemetry chart -->
                <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="LIVE TELEMETRY STREAM" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="TxtSelectedForChart" Text="(all devices)"
                                       FontSize="11" Foreground="{StaticResource AccentCyan}"
                                       DockPanel.Dock="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ctrl:SparklineChart x:Name="Chart"/>
                    </StackPanel>
                </Border>

                <!-- Devices -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Device Console" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"/>
                            <ComboBox Grid.Column="1" x:Name="CmbCategory" Width="130" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Moisture"/>
                                <ComboBoxItem Content="Power"/>
                                <ComboBoxItem Content="Temperature"/>
                                <ComboBoxItem Content="Actuator"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="CmbAlertState" Width="120" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Critical"/>
                            </ComboBox>
                            <Button Grid.Column="3" Content="Refresh" Style="{StaticResource ModernButton}"
                                    Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="2" x:Name="DgDevices" AutoGenerateColumns="False"
                                  Background="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  Foreground="{StaticResource TextPrimary}" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                                  BorderThickness="1" BorderBrush="{StaticResource BorderBrushColor}"
                                  IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="DgDevices_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                                <DataGridTextColumn Header="Last" Binding="{Binding LastValue, StringFormat=N1}" Width="70"/>
                                <DataGridTextColumn Header="State" Binding="{Binding AlertState}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Insights + Commands + Undo -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#BAE6FD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AUTOMATED INSIGHTS" FontSize="11" FontWeight="Bold"
                                   Foreground="#0369A1" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstInsights" Background="Transparent" BorderThickness="0" MaxHeight="180"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="8" Margin="0,2"
                                            BorderBrush="#BAE6FD" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding SuggestedAction}" Foreground="#0C4A6E"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"
                                                           DockPanel.Dock="Left"/>
                                                <Border DockPanel.Dock="Right" Background="#0284C7"
                                                        CornerRadius="8" Padding="6,1">
                                                    <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}"
                                                               Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Reason}" Foreground="#0369A1"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Manual Override" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtSelectedDevice" Text="No device selected"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                        <Button Content="PUMP ON" Style="{StaticResource ModernButton}"
                                Margin="0,0,0,6" Click="BtnPumpOn_Click"/>
                        <Button Content="PUMP OFF" Style="{StaticResource ModernButton}"
                                Background="#64748B" Margin="0,0,0,6" Click="BtnPumpOff_Click"/>
                        <Button Content="RELAY TOGGLE" Style="{StaticResource ModernButton}"
                                Background="{StaticResource AccentCyan}" Margin="0,0,0,6" Click="BtnRelayToggle_Click"/>
                        <Separator Margin="0,8"/>
                        <Button Content="UNDO LAST COMMAND" Style="{StaticResource ModernButton}"
                                Background="#DC2626" Click="BtnUndo_Click"/>
                        <TextBlock x:Name="TxtUndoHint" Text="Stack: empty"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Command History (Stack)" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <ListBox x:Name="LstHistory" MaxHeight="180" Background="#F8FAFC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" TextWrapping="Wrap">
                                        <Run Text="{Binding IssuedAt, StringFormat=\{0:HH:mm:ss\}}" Foreground="#64748B"/>
                                        <Run Text=" • " Foreground="#64748B"/>
                                        <Run Text="{Binding Command}" FontWeight="Bold"/>
                                        <Run Text=" on " Foreground="#64748B"/>
                                        <Run Text="{Binding DeviceName}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Simulator -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="DEVICE SIMULATOR"
                           Foreground="#93C5FD" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Send Normal" Style="{StaticResource ModernButton}"
                            Margin="6,0,0,0" Click="BtnSimulateNormal_Click"/>
                    <Button Content="Send CRITICAL" Style="{StaticResource ModernButton}"
                            Background="#DC2626" Margin="6,0,0,0" Click="BtnSimulateCritical_Click"/>
                    <Button Content="Auto-Stream" Style="{StaticResource ModernButton}"
                            Background="#16A34A" Margin="6,0,0,0" Click="BtnStartAuto_Click"/>
                    <Button Content="Stop" Style="{StaticResource ModernButton}"
                            Background="#64748B" Margin="6,0,0,0" Click="BtnStopAuto_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>