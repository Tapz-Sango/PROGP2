<UserControl x:Class="SmartX.Views.TelemetryStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Three rows: navigation bar, overload calculator, telemetry grid -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar with back button, title, and shortcut to the mesh radar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="&lt; Back" Background="Transparent" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" Click="BtnBack_Click" DockPanel.Dock="Left"/>
            <Button Content="Open Dynamic Mesh Matrix Radar >" Style="{StaticResource ModernButton}" Background="{StaticResource AccentBlue}" DockPanel.Dock="Right" Click="BtnMesh_Click"/>
            <TextBlock Text="Advanced Telemetry &amp; Operator Overloads" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </DockPanel>

        <!-- Overload Calculator -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Smart Meter Operator Overload Aggregator (+ Operator Overload)" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>

                <!-- Three load cards joined by "+" and "=" to show the aggregation -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Smart Meter 1 Load" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="TxtMeter1" Text="450.00 W" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="+" Foreground="{StaticResource AccentBlue}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>

                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Smart Meter 2 Load" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="TxtMeter2" Text="320.00 W" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="3" Text="=" Foreground="{StaticResource AccentBlue}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>

                    <!-- Result card highlighted in green to indicate the aggregated total -->
                    <Border Grid.Column="4" Background="#F0FDF4" CornerRadius="8" Padding="12" BorderBrush="#DCFCE7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Meter3 (Aggregated Load)" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="TxtMeter3" Text="770.00 W" Foreground="{StaticResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Button Content="Simulate Overloaded Telemetry Addition" Style="{StaticResource ModernButton}" Click="BtnAggregate_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Flusher DataGrid -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row with the buffer title and the flush action button -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Optimized List&lt;TelemetryPacket&lt;T&gt;&gt; Ingested Array Buffer" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="Flush Jagged Array Batch to List" Style="{StaticResource ModernButton}" Background="{StaticResource AccentGreen}" DockPanel.Dock="Right" Click="BtnFlushArray_Click"/>
                </DockPanel>

                <!-- Grid showing ingested telemetry packets with custom header and cell styling -->
                <DataGrid Grid.Row="1" x:Name="DgTelemetry" AutoGenerateColumns="False" 
                          Background="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" 
                          Foreground="{StaticResource TextPrimary}" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                          BorderThickness="1" BorderBrush="{StaticResource BorderBrushColor}" SelectionChanged="DgTelemetry_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sensor Identifier" Binding="{Binding SensorId}" Width="200"/>
                        <DataGridTextColumn Header="Telemetry Value (Generic T)" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="150"/>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>