<UserControl x:Class="SmartX.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="&lt; Back" Background="Transparent" Foreground="{StaticResource AccentBlue}"
                    FontWeight="SemiBold" Click="BtnBack_Click" DockPanel.Dock="Left"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Background="#FEF2F2" CornerRadius="14" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtCriticalCount" Text="CRITICAL: 0" Foreground="#B91C1C" FontWeight="Bold" FontSize="11"/>
                </Border>
                <Border Background="#F0F9FF" CornerRadius="14" Padding="10,4">
                    <TextBlock x:Name="TxtFifoCount" Text="FIFO: 0" Foreground="#0369A1" FontWeight="Bold" FontSize="11"/>
                </Border>
            </StackPanel>

            <TextBlock Text="Real-Time Command Stream &amp; History" Foreground="{StaticResource TextPrimary}"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Devices + search/filter -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16" Margin="0,0,12,0"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Device Command Console" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                    <!-- Search / filter row -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"/>
                        <ComboBox Grid.Column="1" x:Name="CmbCategory" Width="140" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Moisture"/>
                            <ComboBoxItem Content="Power"/>
                            <ComboBoxItem Content="Temperature"/>
                            <ComboBoxItem Content="Actuator"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="CmbAlertState" Width="120" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Critical"/>
                        </ComboBox>
                        <Button Grid.Column="3" Content="Refresh" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="DgDevices" AutoGenerateColumns="False"
                              Background="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              Foreground="{StaticResource TextPrimary}" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrushColor}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Last" Binding="{Binding LastValue, StringFormat=N1}" Width="70"/>
                            <DataGridTextColumn Header="State" Binding="{Binding AlertState}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: Insights + Alerts + Undo -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Automated Insights -->
                <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#BAE6FD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AUTOMATED INSIGHTS" FontSize="11" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstInsights" Background="Transparent" BorderThickness="0" MaxHeight="140">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding SuggestedAction}" Foreground="#0C4A6E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="#0369A1" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Command controls -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Manual Override" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtSelectedDevice" Text="No device selected" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                        <Button Content="PUMP ON" Style="{StaticResource ModernButton}" Margin="0,0,0,6" Click="BtnPumpOn_Click"/>
                        <Button Content="PUMP OFF" Style="{StaticResource ModernButton}" Background="#64748B" Margin="0,0,0,6" Click="BtnPumpOff_Click"/>
                        <Button Content="RELAY TOGGLE" Style="{StaticResource ModernButton}" Background="{StaticResource AccentCyan}" Margin="0,0,0,6" Click="BtnRelayToggle_Click"/>
                        <Separator Margin="0,8"/>
                        <Button Content="UNDO LAST COMMAND" Style="{StaticResource ModernButton}" Background="#DC2626" Click="BtnUndo_Click"/>
                        <TextBlock x:Name="TxtUndoHint" Text="Stack: empty" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Command History -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="12" Padding="14"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Command History (Stack)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <ListBox x:Name="LstHistory" MaxHeight="140" Background="#F8FAFC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" TextWrapping="Wrap">
                                        <Run Text="{Binding IssuedAt, StringFormat=\{0:HH:mm:ss\}}" Foreground="#64748B"/>
                                        <Run Text=" • " Foreground="#64748B"/>
                                        <Run Text="{Binding Command}" FontWeight="Bold"/>
                                        <Run Text=" on " Foreground="#64748B"/>
                                        <Run Text="{Binding DeviceName}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Simulator -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="DEVICE SIMULATOR" Foreground="#93C5FD" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Send Normal Telemetry" Style="{StaticResource ModernButton}" Margin="6,0,0,0" Click="BtnSimulateNormal_Click"/>
                    <Button Content="Send CRITICAL Alert" Style="{StaticResource ModernButton}" Background="#DC2626" Margin="6,0,0,0" Click="BtnSimulateCritical_Click"/>
                    <Button Content="Start Auto-Stream" Style="{StaticResource ModernButton}" Background="#16A34A" Margin="6,0,0,0" Click="BtnStartAuto_Click"/>
                    <Button Content="Stop" Style="{StaticResource ModernButton}" Background="#64748B" Margin="6,0,0,0" Click="BtnStopAuto_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>