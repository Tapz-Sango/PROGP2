<UserControl x:Class="SmartX.Views.MeshMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Two-column layout: radar on the left (wider), automated alert feed on the right -->
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIGNAL RADAR GRID ==================== -->
        <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" Margin="0,0,20,0"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar with back button and title -->
                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <Button Content="&lt; Back" Background="Transparent" Foreground="{StaticResource AccentBlue}"
                            FontWeight="SemiBold" Click="BtnBack_Click" DockPanel.Dock="Left"/>
                    <TextBlock Text="DYNAMIC ENGAGEMENT: LIVE MESH SIGNAL RADAR"
                               Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </DockPanel>

                <!-- 3x2 grid of node cards; each shows a status dot and latest reading -->
                <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="10">
                    <Border x:Name="Node1" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource AccentCyan}" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center">
                            <Ellipse x:Name="Dot1" Width="16" Height="16" Fill="{StaticResource AccentCyan}"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="NODE-ESP-01" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="Val1" Text="Telemetry: --" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Node2" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource AccentCyan}" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center">
                            <Ellipse x:Name="Dot2" Width="16" Height="16" Fill="{StaticResource AccentCyan}"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="NODE-ESP-02" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="Val2" Text="Telemetry: --" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Node3" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource AccentCyan}" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center">
                            <Ellipse x:Name="Dot3" Width="16" Height="16" Fill="{StaticResource AccentCyan}"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="NODE-ESP-03" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="Val3" Text="Status: --" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Node4" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Opacity="0.5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NODE-ESP-04" Foreground="{StaticResource TextSecondary}"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Offline" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Node5" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Opacity="0.5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NODE-ESP-05" Foreground="{StaticResource TextSecondary}"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Offline" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Node6" Background="#F8FAFC" CornerRadius="10" Margin="8" Padding="16"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Opacity="0.5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NODE-ESP-06" Foreground="{StaticResource TextSecondary}"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Offline" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Status line showing the simulated packet loop -->
                <TextBlock Grid.Row="2"
                           Text="[LIVE TIMER ACTIVE] Simulated mesh packet loop running every 1.5 seconds..."
                           Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ==================== AUTOMATED ALERT FEED ==================== -->
        <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Automated Alert Feed"
                           Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Text="Alerts are raised automatically when telemetry crosses safe thresholds. Duplicate alerts for the same node + reason are suppressed by the server's HashSet gate."
                           Foreground="{StaticResource TextSecondary}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Live alert list, fed by telemetry not by typing -->
                <ListBox Grid.Row="2" x:Name="LstIssues"
                         Background="#F8FAFC"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderBrushColor}"
                         BorderThickness="1"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,3"
                                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" DockPanel.Dock="Left"/>
                                        <Border DockPanel.Dock="Right"
                                                Background="{Binding SeverityBrush}"
                                                CornerRadius="8" Padding="6,2">
                                            <TextBlock Text="{Binding Severity}"
                                                       Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextPrimary}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer with count + clear button -->
                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="TxtAlertCount" Text="Total alerts: 0"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button Content="Clear Feed" DockPanel.Dock="Right"
                            Style="{StaticResource ModernButton}"
                            Background="#64748B"
                            Padding="10,6"
                            Click="BtnClearFeed_Click"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>